# TestGrid API server (backend) — serves pre-generated data from a mounted dir.
# Build context is the backend repo root.
FROM golang:1.25 AS build
WORKDIR /src

# Cache module downloads first.
COPY go.mod go.sum ./
RUN go mod download

# Build a static binary so it runs on a minimal base image.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/api /api
# HTTP REST. (gRPC binds to localhost only, so it isn't exposed here.)
EXPOSE 8080
ENTRYPOINT ["/api"]
